@@ -0,0 +1,35 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { test } from "vitest";
+import { loadScaleMcpServers } from "./scaleMcpConfig.js";
+
+const server = { name: "living-scale", command: "/usr/bin/python3", args: ["/tmp/mcp_server.py", "--binding", "/tmp/binding.json"], env: [{ name: "PYTHONUNBUFFERED", value: "1" }] };
+function withConfig(value: unknown, run: (file: string) => void) {
+  const dir = mkdtempSync(path.join(os.tmpdir(), "scale-mcp-"));
+  try {
+    const file = path.join(dir, "mcp.json");
+    writeFileSync(file, JSON.stringify(value));
+    run(file);
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+}
+test("scoped MCP remains disabled without explicit config and preserves ACP stdio fields", () => {
+  assert.deepEqual(loadScaleMcpServers(), []);
+  withConfig({ mcpServers: [server] }, (file) => assert.deepEqual(loadScaleMcpServers(file), [server]));
+});
+test("invalid explicit MCP paths fail without leaking file contents", () => {
+  assert.throws(() => loadScaleMcpServers("relative.json"), /must be absolute/);
+  assert.throws(() => loadScaleMcpServers("/nonexistent/scale.json"), /cannot read or parse/);
+});
+for (const value of [
+  {}, { mcpServers: "wrong" }, { mcpServers: [server], secret: "never-print" },
+  { mcpServers: [{ ...server, command: "python3" }] },
+  { mcpServers: [{ ...server, args: [1] }] },
+  { mcpServers: [{ ...server, env: { TOKEN: "never-print" } }] },
+  { mcpServers: [{ ...server, env: [{ name: "BAD-NAME", value: "x" }] }] },
+  { mcpServers: [{ ...server, url: "https://unexpected" }] },
+  { mcpServers: [server, server] },
+]) test(`reject invalid ACP configuration ${JSON.stringify(value).slice(0, 55)}`, () => {
+  withConfig(value, (file) => assert.throws(() => loadScaleMcpServers(file), /Invalid LIVING_SCALE_MCP_CONFIG/));
+});
