+++ b/packages/web/tests/scaleChartCard.behavior.test.tsx
@@ -0,0 +1,177 @@
+import "./helpers/domSetup";
+import { gzipSync } from "node:zlib";
+import assert from "node:assert/strict";
+import test, { afterEach } from "node:test";
+import { cleanup, fireEvent, render, screen, within, waitFor } from "@testing-library/react";
+import { act } from "react";
+import { MemoryRouter } from "react-router-dom";
+import { TestIntlProvider } from "./helpers/intl";
+import MessageInput from "../src/components/message/MessageInput";
+import api from "../src/api/client";
+import { useMessageStore } from "../src/store/messageStore";
+import ScaleChartCard, { parseScaleChartMessage, scaleChartIsSuperseded, formatScaleFact, ScaleFactChart, type ScaleChartPayload } from "../src/components/message/ScaleChartCard";
+
+afterEach(cleanup);
+const payload = {
+  presentation_version: "chat-scale-card-1.0", message_type: "scale_chart_update",
+  source_assessment: { assessment_id: "a1", assessment_revision: 1, patient_id: "p1", stale: false, evaluation_at: "2026-01-21", knowledge_as_of: "2026-01-22" },
+  source_profile: {}, trend: {}, update: {}, history: [], source_messages: [],
+  facts: [{ fact_ref: "f1", fact_revision: 1, concept: "ferritin", value: 15000, operator: ">", unit: "ng/mL", event_time: "2026-01-21" }],
+  display_context: { diagnosis_record: { value: "尚未确诊" } },
+  interpretation: { statement: "请结合临床资料复核" }, warning: { message: "存在量表信号" },
+  scales: { mas_2016: { entry: { eligibility: "unknown" }, process: { matched_count: 3 }, result: { mathematical_result: "met" } } },
+} as ScaleChartPayload;
+const envelope = (p: unknown) => `\x60\x60\x60scale_chart_update\n${JSON.stringify(p)}\n\x60\x60\x60`;
+test("only complete valid envelopes become cards", () => {
+  assert.ok(parseScaleChartMessage(envelope(payload)));
+  assert.equal(parseScaleChartMessage(envelope({ ...payload, facts: [{ fact_ref: 1 }] })), null);
+  assert.equal(parseScaleChartMessage(envelope({ ...payload, scales: { mas_2016: { result: {} } } })), null);
+  assert.equal(parseScaleChartMessage(`ordinary text\n${envelope(payload)}`), null);
+  assert.equal(parseScaleChartMessage('```scale_chart_update\nnot json\n```'), null);
+});
+test("censored facts preserve their comparator and correction refers to the precise fact", () => {
+  assert.equal(formatScaleFact(payload.facts[0]), "> 15000 ng/mL");
+  render(<ScaleChartCard payload={payload} channelId="channel-1" agentId="agent-1" agentName="scale-study" />);
+  assert.ok(screen.getByText("> 15000 ng/mL"));
+  let detail: unknown;
+  const listener = (e: Event) => { detail = (e as CustomEvent).detail; };
+  window.addEventListener("scale-chart-correct", listener);
+  fireEvent.click(screen.getByRole("button", { name: "更正此事实" }));
+  window.removeEventListener("scale-chart-correct", listener);
+  assert.deepEqual(detail, { patient_id: "p1", assessment_id: "a1", fact_ref: "f1", channel_id: "channel-1", agent_id: "agent-1", agent_name: "scale-study" });
+});
+test("original scale result is isolated from diagnosis and stale alerts are historical", () => {
+  render(<ScaleChartCard payload={{ ...payload, source_assessment: { ...payload.source_assessment, stale: true } }} />);
+  const summary = screen.getByRole("region", { name: "本次摘要" });
+  assert.ok(within(summary).getByText("尚未确诊"));
+  assert.equal(within(summary).queryByText("达到"), null);
+  assert.ok(screen.getByText("达到"));
+  assert.ok(screen.getByText("历史版本已失效，请以更新后的评估为准。"));
+  assert.ok(screen.getByText("当时的提醒（已失效）", { exact: false }));
+});
+
+test("trend intervals keep open bounds and units without replacing them with exact points", () => {
+  render(<ScaleChartCard payload={{ ...payload, trend: { ferritin: { previous: { status: "calculated", reference_value: { value: 100, unit: "ng/mL" }, current_value: { value: 15000, operator: ">", unit: "ng/mL" }, absolute_change: { lower: "14900", upper: null, lower_open: true, upper_open: true, unit: "ng/mL" } } } } }} />);
+  assert.ok(screen.getByText("绝对变化：(14900, +∞) ng/mL"));
+  assert.ok(screen.getByText("本次值：> 15000 ng/mL"));
+});
+
+
+test("correction drafts stay within the card channel and preserve existing text", async () => {
+  const originalGet = api.get;
+  api.get = (async () => ({ data: [] })) as typeof api.get;
+  useMessageStore.setState({ drafts: { "correction-channel": "已有内容" } });
+  try {
+    render(<MemoryRouter><TestIntlProvider><MessageInput channelId="correction-channel" channelName="随诊" /></TestIntlProvider></MemoryRouter>);
+    const input = screen.getByRole("textbox") as HTMLTextAreaElement;
+    fireEvent(window, new window.CustomEvent("scale-chart-correct", { detail: { channel_id: "another-channel", fact_ref: "wrong" } }));
+    assert.equal(input.value, "已有内容");
+    fireEvent(window, new window.CustomEvent("scale-chart-correct", { detail: { channel_id: "correction-channel", fact_ref: "ferritin-1", agent_id: "agent-1", agent_name: "scale-study" } }));
+    await waitFor(() => assert.equal(input.value, "已有内容\n@scale-study 更正事实 ferritin-1："));
+  } finally { api.get = originalGet; }
+});
+
+test("supersession is patient and channel scoped and preserves the original payload", () => {
+  const newer = { ...payload, source_assessment: { ...payload.source_assessment, assessment_id: "a2", supersedes: "a1" }, history: [{ assessment_id: "a1", stale: true }] };
+  assert.equal(scaleChartIsSuperseded(payload, "c1", [{ channelId: "c2", content: envelope(newer), senderType: "agent" }]), false);
+  assert.equal(scaleChartIsSuperseded(payload, "c1", [{ channelId: "c1", content: envelope(newer), senderType: "agent" }]), true);
+  assert.equal(scaleChartIsSuperseded(payload, "c1", [{ channelId: "c1", content: envelope(newer), senderType: "human" }]), false);
+  assert.equal(payload.source_assessment.stale, false);
+});
+
+test("history cards use Raft message permalinks", () => {
+  render(<ScaleChartCard payload={{ ...payload, history: [{ assessment_id: "a0", revision: 1, channel_id: "c0", card_message_id: "m0" }] }} serverSlug="dev" />);
+  assert.match(screen.getByRole("link", { name: "查看历史卡片" }).getAttribute("href") ?? "", /\/s\/dev\/channel\/c0.*m0/);
+});
+
+
+test("compressed transport preserves full payload and rejects corrupt or oversized envelopes", () => {
+  const large = { ...payload, interpretation: { statement: "完整证据".repeat(8000) } };
+  const bytes = Buffer.from(JSON.stringify(large), "utf8");
+  const packed = { encoding: "gzip-base64", uncompressed_bytes: bytes.length, data: gzipSync(bytes).toString("base64") };
+  assert.deepEqual(parseScaleChartMessage(envelope(packed)), large);
+  assert.equal(parseScaleChartMessage(envelope({ ...packed, uncompressed_bytes: bytes.length + 1 })), null);
+  assert.equal(parseScaleChartMessage(envelope({ ...packed, uncompressed_bytes: 2_000_001 })), null);
+  assert.equal(parseScaleChartMessage(envelope({ ...packed, data: "not!base64" })), null);
+  assert.equal(parseScaleChartMessage(envelope({ ...packed, data: Buffer.alloc(32_001).toString("base64") })), null);
+  const invalid = Buffer.from("not a scale payload");
+  assert.equal(parseScaleChartMessage(envelope({ encoding: "gzip-base64", uncompressed_bytes: invalid.length, data: gzipSync(invalid).toString("base64") })), null);
+});
+
+
+test("raw trend graphics never connect a censored value or mix literal units", () => {
+  const facts = [
+    { fact_ref: "a", concept: "ferritin", event_time: "2026-01-01", value: 100, operator: "=", unit: "ng/mL" },
+    { fact_ref: "b", concept: "ferritin", event_time: "2026-01-02", value: 2000, operator: ">", unit: "ng/mL" },
+    { fact_ref: "c", concept: "ferritin", event_time: "2026-01-03", value: 500, operator: "=", unit: "ng/mL" },
+    { fact_ref: "d", concept: "ferritin", event_time: "2026-01-04", value: 600, operator: "=", unit: "ng/mL" },
+    { fact_ref: "e", concept: "ferritin", event_time: "2026-01-05", value: 0.7, operator: "=", unit: "mg/L" },
+  ];
+  const { container } = render(<ScaleFactChart facts={facts} concept="ferritin" />);
+  assert.equal(container.querySelectorAll('svg[data-scale-unit="ng/mL"] [data-exact-segment]').length, 1);
+  assert.equal(container.querySelectorAll('svg[data-scale-unit="mg/L"] [data-exact-segment]').length, 0);
+  assert.equal(container.querySelector('[data-fact-ref="b"]')?.getAttribute("data-observation-kind"), "bound");
+  assert.equal(container.querySelector('[data-fact-ref="b"] circle')?.getAttribute("fill"), "white");
+  assert.ok(screen.getByText("↑ > 2000 ng/mL"));
+});
+
+
+test("HLH absence of an entry check does not imply that the patient is ineligible", () => {
+  render(<ScaleChartCard payload={{ ...payload, scales: { hlh_2004: { entry: { eligibility: "not_applicable", clinical_review: "not_applicable", selection_status: "requested" }, process: { calculation_status: "complete" }, result: { status: "criteria_met" } } } }} />);
+  assert.equal(screen.getAllByText("此原表不使用该项入口检查").length, 2);
+  assert.equal(screen.queryByText("不适用", { exact: true }), null);
+  assert.ok(screen.getByText("达到标准"));
+});
+
+
+test("available key plots are visible outside accordions and interpretation failures are explicit", () => {
+  render(<ScaleChartCard payload={{ ...payload, execution: { module_statuses: { interpretation: "failed" } } }} />);
+  const plots = screen.getByRole("region", { name: "关键指标趋势" });
+  assert.ok(within(plots).getByRole("img", { name: "铁蛋白原始观测图（ng/mL）" }));
+  assert.equal(plots.closest("details"), null);
+  assert.ok(screen.getByText("动态解释暂未生成；已完成的计算仍保留"));
+  assert.equal(screen.queryByText("请结合临床资料复核"), null);
+});
+
+test("correction card submission sends a formal trusted agent mention and preserves earlier mentions", async () => {
+  const originalGet = api.get;
+  const originalSend = useMessageStore.getState().sendMessage;
+  const calls: Parameters<typeof originalSend>[] = [];
+  api.get = (async () => ({ data: [] })) as typeof api.get;
+  useMessageStore.setState({ drafts: {}, sendMessage: async (...args) => {
+    calls.push(args);
+    return { messageId: "sent", pendingMentionActions: [], unresolvedMentionHandles: [] };
+  } });
+  try {
+    render(<MemoryRouter><TestIntlProvider>
+      <ScaleChartCard payload={payload} channelId="correction-send" agentId="trusted-agent-id" agentName="trusted-scale-agent" />
+      <MessageInput channelId="correction-send" channelName="随诊" />
+    </TestIntlProvider></MemoryRouter>);
+    fireEvent(window, new window.CustomEvent("scale-chart-correct", { detail: { channel_id: "correction-send", fact_ref: "previous", agent_id: "other-agent", agent_name: "other-helper" } }));
+    fireEvent.click(screen.getByRole("button", { name: "更正此事实" }));
+    const input = screen.getByRole("textbox") as HTMLTextAreaElement;
+    assert.match(input.value, /@trusted-scale-agent 更正事实 f1：/);
+    await act(async () => { fireEvent.submit(input.closest("form")!); });
+    await waitFor(() => assert.equal(calls.length, 1));
+    assert.equal(calls[0][0], "correction-send");
+    assert.deepEqual(calls[0][6], [
+      { type: "agent", id: "other-agent", name: "other-helper" },
+      { type: "agent", id: "trusted-agent-id", name: "trusted-scale-agent" },
+    ]);
+  } finally { api.get = originalGet; useMessageStore.setState({ sendMessage: originalSend }); }
+});
+
+test("conflicting facts break lines and time spacing reflects actual elapsed days", () => {
+  const facts = [
+    { fact_ref: "day1", concept: "ast", event_time: "2026-01-01", value: 30, state: "present", unit: "U/L" },
+    { fact_ref: "day2", concept: "ast", event_time: "2026-01-02", value: 40, state: "conflict", unit: "U/L" },
+    { fact_ref: "day5", concept: "ast", event_time: "2026-01-05", value: 60, state: "present", unit: "U/L" },
+  ];
+  const { container, rerender } = render(<ScaleFactChart facts={facts} concept="ast" />);
+  assert.equal(formatScaleFact(facts[1]), "来源冲突");
+  assert.equal(container.querySelector('[data-fact-ref="day2"]'), null);
+  assert.equal(container.querySelectorAll('[data-exact-segment]').length, 0);
+  rerender(<ScaleFactChart facts={facts.map(f => ({ ...f, state: "present" }))} concept="ast" />);
+  const cx = (id: string) => Number(container.querySelector(`[data-fact-ref="${id}"] circle`)?.getAttribute("cx"));
+  assert.ok(Math.abs((cx("day2") - cx("day1")) / (cx("day5") - cx("day1")) - 0.25) < 0.0001);
+});
