+import { gunzipSync } from "fflate";
+import { buildMessagePermalink } from "../../hooks/useAppNavigate";
+
+type RecordValue = Record<string, unknown>;
+interface Fact extends RecordValue { fact_ref: string; concept: string; }
+export interface ScaleChartPayload extends RecordValue {
+  presentation_version: "chat-scale-card-1.0";
+  message_type: "scale_chart_update";
+  source_assessment: RecordValue & { assessment_id: string; patient_id: string; stale: boolean };
+  facts: Fact[];
+  scales: Record<string, RecordValue>;
+  display_context: RecordValue;
+  interpretation: RecordValue;
+  warning: RecordValue;
+  source_messages: Array<{ message_id: string; channel_id: string }>;
+  history: RecordValue[];
+  trend: RecordValue;
+}
+const object = (value: unknown): value is RecordValue => !!value && typeof value === "object" && !Array.isArray(value);
+const nonempty = (value: unknown): value is string => typeof value === "string" && value.trim().length > 0;
+
+/** Only an entire, validated fenced message is replaced; malformed content retains normal markdown. */
+export function parseScaleChartMessage(content: string): ScaleChartPayload | null {
+  const match = /^\s*```scale_chart_update\s*\n([\s\S]*?)\n```\s*$/.exec(content);
+  if (!match || match[1].length > 1_000_000) return null;
+  try {
+    let p: unknown = JSON.parse(match[1]);
+    if (object(p) && p.encoding === "gzip-base64") {
+      const size = p.uncompressed_bytes;
+      if (typeof size !== "number" || !Number.isInteger(size) || size <= 0 || size > 2_000_000 || typeof p.data !== "string" || p.data.length > 42_668 || !/^[A-Za-z0-9+/]*={0,2}$/.test(p.data) || p.data.length % 4 !== 0) return null;
+      const binary = atob(p.data);
+      if (binary.length < 18 || binary.length > 32_000) return null;
+      const compressed = Uint8Array.from(binary, char => char.charCodeAt(0));
+      const trailerSize = new DataView(compressed.buffer).getUint32(compressed.length - 4, true);
+      if (compressed[0] !== 0x1f || compressed[1] !== 0x8b || trailerSize !== size) return null;
+      const uncompressed = gunzipSync(compressed);
+      if (uncompressed.length !== size) return null;
+      p = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(uncompressed));
+    }
+    if (!object(p) || p.presentation_version !== "chat-scale-card-1.0" || p.message_type !== "scale_chart_update") return null;
+    const a = p.source_assessment;
+    if (!object(a) || !nonempty(a.assessment_id) || !nonempty(a.patient_id) || typeof a.stale !== "boolean" || !Number.isInteger(a.assessment_revision)) return null;
+    if (!Array.isArray(p.facts) || !p.facts.every(f => object(f) && nonempty(f.fact_ref) && nonempty(f.concept))) return null;
+    if (!object(p.scales) || !Object.values(p.scales).every(s => object(s) && object(s.entry) && object(s.process) && object(s.result))) return null;
+    if (![p.display_context, p.interpretation, p.warning, p.source_profile, p.trend, p.update].every(object)) return null;
+    if (!Array.isArray(p.history) || !p.history.every(object) || !Array.isArray(p.source_messages) || !p.source_messages.every(s => object(s) && nonempty(s.message_id) && nonempty(s.channel_id))) return null;
+    return p as unknown as ScaleChartPayload;
+  } catch { return null; }
+}
+export function scaleChartIsSuperseded(payload: ScaleChartPayload, channelId: string, siblings: ReadonlyArray<{ channelId: string; content: string; senderType: string }>): boolean {
+  const id = payload.source_assessment.assessment_id;
+  return siblings.some(message => {
+    if (message.channelId !== channelId || message.senderType !== "agent") return false;
+    const later = parseScaleChartMessage(message.content);
+    if (!later || later.source_assessment.assessment_id === id || later.source_assessment.patient_id !== payload.source_assessment.patient_id) return false;
+    return later.source_assessment.supersedes === id || later.history.some(h => h.assessment_id === id && h.stale === true);
+  });
+}
+const labels: Record<string, string> = {
