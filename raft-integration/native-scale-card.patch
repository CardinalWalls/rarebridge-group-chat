@@ -0,0 +1,55 @@
+import { readFileSync } from "node:fs";
+import path from "node:path";
+
+/** ACP stdio MCP server configuration, explicitly selected per agent launch. */
+export interface ScaleMcpServer {
+  name: string;
+  command: string;
+  args: string[];
+  env: { name: string; value: string }[];
+}
+
+function invalid(detail: string): never {
+  throw new Error(`Invalid LIVING_SCALE_MCP_CONFIG: ${detail}`);
+}
+function record(value: unknown, keys: string[], label: string): Record<string, unknown> {
+  if (!value || typeof value !== "object" || Array.isArray(value)) invalid(`${label} must be an object`);
+  const result = value as Record<string, unknown>;
+  if (Object.keys(result).some((key) => !keys.includes(key))) invalid(`${label} contains unsupported fields`);
+  return result;
+}
+function text(value: unknown, label: string, allowEmpty = false): string {
+  if (typeof value !== "string" || value.includes("\0") || (!allowEmpty && !value.trim())) invalid(`${label} must be a valid string`);
+  return value;
+}
+
+export function loadScaleMcpServers(configPath?: string | null): ScaleMcpServer[] {
+  if (configPath === undefined || configPath === null) return [];
+  if (!path.isAbsolute(text(configPath, "config path"))) invalid("config path must be absolute");
+  let parsed: unknown;
+  try { parsed = JSON.parse(readFileSync(configPath, "utf8")); }
+  catch { invalid("cannot read or parse the designated JSON file"); }
+  const config = record(parsed, ["mcpServers"], "config");
+  if (!Array.isArray(config.mcpServers)) invalid("mcpServers must be an array");
+  const names = new Set<string>();
+  return config.mcpServers.map((value, i) => {
+    const server = record(value, ["name", "command", "args", "env"], `server ${i}`);
+    const name = text(server.name, "server name");
+    if (names.has(name)) invalid("server names must be unique");
+    names.add(name);
+    const command = text(server.command, "command");
+    if (!path.isAbsolute(command)) invalid("command must be absolute");
+    if (!Array.isArray(server.args)) invalid("args must be an array");
+    const args = server.args.map((arg) => text(arg, "argument", true));
+    if (!Array.isArray(server.env)) invalid("env must be an array");
+    const envNames = new Set<string>();
+    const env = server.env.map((value) => {
+      const entry = record(value, ["name", "value"], "env entry");
+      const name = text(entry.name, "environment name");
+      if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(name) || envNames.has(name)) invalid("environment names must be valid and unique");
+      envNames.add(name);
+      return { name, value: text(entry.value, "environment value", true) };
+    });
+    return { name, command, args, env };
+  });
+}
