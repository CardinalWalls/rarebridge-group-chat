+function text(value: unknown): string {
+  if (value == null || value === "" || (typeof value === "string" && value.startsWith("unknown"))) return "未知";
+  if (typeof value === "string") return labels[value] ?? value;
+  if (typeof value === "number" || typeof value === "boolean") return labels[String(value)] ?? String(value);
+  if (Array.isArray(value)) return value.map(text).join("；") || "无";
+  if (object(value)) return Object.entries(value).filter(([k]) => labels[k]).map(([k, v]) => `${labels[k]}：${text(v)}`).join("；") || "未提供";
+  return "未知";
+}
+export function formatScaleFact(f: RecordValue): string {
+  const unit = typeof f.unit === "string" ? ` ${f.unit}` : "";
+  if (f.state === "conflict") return "来源冲突";
+  if (f.state === "not_applicable") return "不适用";
+  if (f.state === "missing" || f.state === "unknown") return "未知";
+  if (f.lower != null || f.upper != null) {
+    if (f.lower != null && f.upper === f.lower && !f.lower_open && !f.upper_open) return `${text(f.lower)}${unit}`;
+    return `${f.lower_open ? "(" : "["}${f.lower == null ? "−∞" : text(f.lower)}, ${f.upper == null ? "+∞" : text(f.upper)}${f.upper_open ? ")" : "]"}${unit}`;
+  }
+  return `${f.operator && f.operator !== "=" ? text(f.operator) + " " : ""}${text(f.value)}${unit}`;
+}
+function ScaleSection({ value, entry = false }: { value: RecordValue; entry?: boolean }) {
+  const rows = Object.entries(value).filter(([key]) => labels[key]);
+  return rows.length ? <dl className="space-y-1">{rows.map(([key, v]) => <div key={key}><dt className="inline font-medium">{labels[key]}：</dt><dd className="inline">{entry && (key === "eligibility" || key === "clinical_review") && v === "not_applicable" ? value.selection_status === "not_requested" ? "本次未选择" : "此原表不使用该项入口检查" : text(v)}</dd></div>)}</dl> : <p>{text(value)}</p>;
+}
+/** Plot recorded values only. Each literal unit gets its own independent visual axis. */
+export function ScaleFactChart({ facts, concept }: { facts: Fact[]; concept: string }) {
+  const observations = facts.filter(f => f.concept === concept).sort((a, b) => (Date.parse(String(a.event_time)) || 0) - (Date.parse(String(b.event_time)) || 0));
+  const units = [...new Set(observations.map(f => typeof f.unit === "string" ? f.unit : ""))];
+  return <div className="space-y-2">{units.map(unit => {
+    const group = observations.filter(f => (typeof f.unit === "string" ? f.unit : "") === unit);
+    const points = group.map((fact, index) => {
+      const value = typeof fact.value === "number" ? fact.value : typeof fact.value === "string" && fact.value.trim() ? Number(fact.value) : NaN;
+      const valid = Number.isFinite(value) && fact.state !== "unknown" && fact.state !== "missing" && fact.state !== "conflict" && fact.state !== "not_applicable" && Number.isFinite(Date.parse(String(fact.event_time))) && fact.lower == null && fact.upper == null;
+      const exact = valid && (fact.operator == null || fact.operator === "=");
+      return { fact, index, value, valid, exact };
+    });
+    const valid = points.filter(p => p.valid);
+    if (!valid.length) return null;
+    const minimum = Math.min(...valid.map(p => p.value));
+    const maximum = Math.max(...valid.map(p => p.value));
+    const times = group.map(f => Date.parse(String(f.event_time))).filter(Number.isFinite);
+    const t0 = Math.min(...times), t1 = Math.max(...times);
+    const x = (index: number) => 42 + (Date.parse(String(group[index].event_time)) - t0) * 322 / Math.max(1, t1 - t0);
+    const y = (value: number) => maximum === minimum ? 80 : 118 - (value - minimum) * 76 / (maximum - minimum);
+    const label = `${labels[concept] ?? concept}原始观测图${unit ? `（${unit}）` : ""}`;
+    return <figure key={unit} className="min-w-0 rounded border border-black/15 p-2">
+      <figcaption className="text-xs font-medium">{label}</figcaption>
+      <svg viewBox="0 0 420 160" role="img" aria-label={label} className="h-auto w-full max-w-lg" data-scale-unit={unit}>
+        <title>{label}；空心箭头为带比较符的边界记录，不作为精确值连线。</title>
+        <path d="M 42 28 V 128 H 376" fill="none" stroke="currentColor" strokeOpacity="0.3" />
+        <text x="3" y="43" fontSize="10">{maximum}</text><text x="3" y="122" fontSize="10">{minimum}</text>
+        {points.map((point, i) => {
+          const previous = points[i - 1];
+          return point.exact && previous?.exact ? <line key={`line-${i}`} data-exact-segment="true" x1={x(previous.index)} y1={y(previous.value)} x2={x(point.index)} y2={y(point.value)} stroke="currentColor" strokeWidth="2" /> : null;
+        })}
+        {valid.map(point => <g key={point.fact.fact_ref} data-fact-ref={point.fact.fact_ref} data-observation-kind={point.exact ? "exact" : "bound"}>
+          <title>{String(point.fact.event_time ?? "日期未知")}：{formatScaleFact(point.fact)}</title>
+          <circle cx={x(point.index)} cy={y(point.value)} r="4" fill={point.exact ? "currentColor" : "white"} stroke="currentColor" strokeWidth="2" />
+          {!point.exact && <text x={x(point.index)} y={y(point.value) - 9} textAnchor="middle" fontSize="13">{String(point.fact.operator).startsWith(">") ? "↑" : String(point.fact.operator).startsWith("<") ? "↓" : "◇"} {formatScaleFact(point.fact)}</text>}
+        </g>)}
+        <text x="42" y="149" fontSize="10">{String(group[0].event_time ?? "日期未知").slice(0, 10)}</text>
+        {group.length > 1 && <text x="364" y="149" textAnchor="end" fontSize="10">{String(group[group.length - 1].event_time ?? "日期未知").slice(0, 10)}</text>}
+      </svg>
+      <p className="text-xs">实心点为精确值；空心箭头仅标示原始边界，不与相邻点连线。</p>
+    </figure>;
+  })}</div>;
+}
+export default function ScaleChartCard({ payload: p, serverSlug, channelId, agentId, agentName }: { payload: ScaleChartPayload; serverSlug?: string; channelId?: string; agentId?: string; agentName?: string }) {
+  const a = p.source_assessment;
+  const execution = object(p.execution) ? p.execution : null;
+  const moduleStatuses = execution && object(execution.module_statuses) ? execution.module_statuses : null;
+  const interpretationFailed = moduleStatuses?.interpretation === "failed";
+  const visibleMetrics = ["ferritin", "platelets", "ast"].filter(concept => p.facts.some(f => f.concept === concept && f.state !== "unknown" && f.state !== "missing" && (typeof f.value === "number" || (typeof f.value === "string" && f.value.trim() !== "" && Number.isFinite(Number(f.value))))));
+  const facts = [...p.facts].sort((x, y) => String(x.event_time ?? "9999").localeCompare(String(y.event_time ?? "9999")));
+  const correct = (fact: Fact) => window.dispatchEvent(new window.CustomEvent("scale-chart-correct", { detail: { patient_id: a.patient_id, assessment_id: a.assessment_id, fact_ref: fact.fact_ref, channel_id: channelId, agent_id: agentId, agent_name: agentName } }));
+  return <article className="my-2 w-full min-w-0 max-w-2xl space-y-3 rounded-lg border border-black/20 bg-white p-3 text-sm text-black break-words" aria-label="随诊量表更新">
+    <section aria-label="本次摘要" className="space-y-2">
+      <h3 className="font-bold">随诊量表更新 · {a.patient_id}</h3>
+      <p>评估日期：{text(a.evaluation_at)} · 资料截至：{text(a.knowledge_as_of)}</p>
+      {a.stale && <p role="status" className="font-bold">历史版本已失效，请以更新后的评估为准。</p>}
+      {a.mode === "retrospective" && <p>回顾评估：用于整理当时资料。</p>}
+      <p>{interpretationFailed ? "动态解释暂未生成；已完成的计算仍保留" : text(p.interpretation.statement)}</p>
+      <dl className="grid grid-cols-1 gap-1 sm:grid-cols-2">{[["care_phase", "诊疗阶段"], ["care_setting", "就诊场景"], ["diagnosis_record", "诊断记录"], ["evidence_identity", "证据身份"]].map(([key, label]) => <div key={key}><dt className="inline font-medium">{label}：</dt><dd className="inline">{text(object(p.display_context[key]) ? p.display_context[key].value : null)}</dd></div>)}</dl>
+      <div className="rounded border border-black/10 p-2"><strong>{a.stale ? "当时的提醒（已失效）" : "本次评估当时的提示"}：</strong>{interpretationFailed ? "本次未生成新提醒；此前结果见历史版本" : text(p.warning.message ?? p.warning.status)}<p className="mt-1 text-xs">量表结果与提醒不等同于诊断；诊断以诊疗记录为准。</p></div>
+    </section>
+    {visibleMetrics.length > 0 && <section aria-label="关键指标趋势" className="space-y-2">{visibleMetrics.map(concept => <ScaleFactChart key={concept} facts={facts} concept={concept} />)}</section>}
+    <details><summary className="cursor-pointer font-bold">事实时间线（{facts.length} 项）</summary><ol className="mt-2 space-y-3">{facts.map((f, i) => <li key={`${f.fact_ref}-${i}`} className="border-l-2 border-black/20 pl-2"><p>{text(f.event_time)} · {labels[f.concept] ?? f.concept}：<strong>{formatScaleFact(f)}</strong></p><p className="text-xs">记录时间：{text(f.recorded_time)} · 事实版本：{text(f.fact_revision)}</p><p className="text-xs">来源：{object(f.source) ? text(f.source.quote ?? f.source.source_ids ?? f.source.label ?? f.source.message_id) : text(f.source)}</p><button type="button" disabled={!agentId || !agentName} onClick={() => correct(f)} className="mt-1 underline">更正此事实</button><p className="select-text text-xs">更正 {labels[f.concept] ?? f.concept}（{f.fact_ref}）</p></li>)}</ol></details>
+    <details><summary className="cursor-pointer font-bold">指标变化</summary><div className="mt-2 space-y-3">{Object.entries(p.trend).filter(([, v]) => object(v)).map(([lab, value]) => <details key={lab}><summary className="cursor-pointer font-bold">{labels[lab] ?? lab}</summary>{!visibleMetrics.includes(lab) && <ScaleFactChart facts={facts} concept={lab} />}{(["previous", "first"] as const).map(mode => {
+      const group = (value as RecordValue)[mode];
+      if (!object(group)) return null;
+      if (group.status === "no_reference") return <p key={mode}>{labels[mode]}：暂无参照记录</p>;
+      return <div key={mode} className="mt-1 border-l-2 border-black/15 pl-2"><strong>{labels[mode]}</strong>{["reference_value", "current_value", "absolute_change", "percent_change"].map(key => <p key={key}>{labels[key]}：{object(group[key]) ? formatScaleFact(group[key]) : "未知"}</p>)}{group.status != null && <p>状态：{text(group.status)}</p>}</div>;
+    })}</details>)}</div></details>
+    <details><summary className="cursor-pointer font-bold">原量表结果</summary><div className="mt-2 space-y-3">{Object.entries(p.scales).map(([key, scale]) => <details key={key} className="rounded border border-black/15 p-2"><summary className="cursor-pointer font-bold">{labels[key] ?? key} · {text((scale.result as RecordValue).status ?? (scale.process as RecordValue).calculation_status)}</summary>{[["entry", "入口与适用前提"], ["process", "计算过程"], ["result", "量表原结果"]].map(([part, label]) => <div key={part} className="mt-2"><h5 className="font-medium">{label}</h5><ScaleSection value={scale[part] as RecordValue} entry={part === "entry"} /></div>)}</details>)}</div></details>
+    <details><summary className="cursor-pointer font-bold">证据与历史版本</summary><div className="mt-2 space-y-2"><p>当前评估版本：{text(a.assessment_revision)}</p>{p.source_messages.map((s, i) => <p key={`${s.message_id}-${i}`}>{serverSlug ? <a className="underline" href={buildMessagePermalink(serverSlug, s.channel_id, s.message_id)}>查看来源消息 {i + 1}</a> : <span>来源消息：{s.message_id}</span>}</p>)}{p.history.map((h, i) => <p key={i}>历史评估：{text(h.assessment_id)} · 版本 {text(h.revision ?? h.assessment_revision)} {serverSlug && nonempty(h.channel_id ?? channelId) && nonempty(h.card_message_id) && <a className="underline" href={buildMessagePermalink(serverSlug, String(h.channel_id ?? channelId), h.card_message_id)}>查看历史卡片</a>}</p>)}<details><summary className="cursor-pointer">原始数据</summary><pre className="max-h-80 overflow-auto whitespace-pre-wrap break-all text-xs">{JSON.stringify(p, null, 2)}</pre></details></div></details>
+  </article>;
+}
diff --git a/packages/web/tests/scaleChartCard.behavior.test.tsx b/packages/web/tests/scaleChartCard.behavior.test.tsx
